{
 "total": 87.12320833333335,
 "vo_end": 77.62320833333335,
 "intro": 1.6,
 "timeline": [
  {
   "line": 0,
   "sub": 0,
   "who": "N",
   "start": 1.6,
   "end": 3.278,
   "text": "Most of you said... stay seated."
  },
  {
   "line": 1,
   "sub": 0,
   "who": "N",
   "start": 3.978,
   "end": 7.154,
   "text": "So you don't move. The doors close... and your sister stops waving."
  },
  {
   "line": 2,
   "sub": 0,
   "who": "N",
   "start": 7.604,
   "end": 10.374,
   "text": "She walks up to the glass. Slowly. And tilts her head."
  },
  {
   "line": 3,
   "sub": 0,
   "who": "N",
   "start": 10.824,
   "end": 13.707,
   "text": "The train pulls away. She doesn't follow. She just watches."
  },
  {
   "line": 4,
   "sub": 0,
   "who": "N",
   "start": 14.357,
   "end": 16.616,
   "text": "You check your phone. One thirty-one A.M."
  },
  {
   "line": 5,
   "sub": 0,
   "who": "N",
   "start": 17.066,
   "end": 18.948,
   "text": "A minute later... still one thirty-one."
  },
  {
   "line": 6,
   "sub": 0,
   "who": "N",
   "start": 19.398,
   "end": 24.701,
   "text": "Ten minutes later... still one thirty-one. The seconds keep looping. Time isn't moving. Only the train is."
  },
  {
   "line": 7,
   "sub": 0,
   "who": "N",
   "start": 25.151,
   "end": 29.779,
   "text": "Something is scratched into the window. Rule number four. Count the stations. There are only seven."
  },
  {
   "line": 8,
   "sub": 0,
   "who": "N",
   "start": 30.229,
   "end": 30.719,
   "text": "One"
  },
  {
   "line": 8,
   "sub": 1,
   "who": "N",
   "start": 31.519,
   "end": 32.017,
   "text": "Two"
  },
  {
   "line": 8,
   "sub": 2,
   "who": "N",
   "start": 32.817,
   "end": 33.329,
   "text": "Three"
  },
  {
   "line": 9,
   "sub": 0,
   "who": "N",
   "start": 34.079,
   "end": 36.44,
   "text": "At station four, the lights flicker back on."
  },
  {
   "line": 10,
   "sub": 0,
   "who": "N",
   "start": 36.89,
   "end": 38.918,
   "text": "And every seat in your car... is taken."
  },
  {
   "line": 11,
   "sub": 0,
   "who": "N",
   "start": 39.568,
   "end": 43.273,
   "text": "No faces. No breathing. And every single head... is turned toward you."
  },
  {
   "line": 12,
   "sub": 0,
   "who": "N",
   "start": 43.973,
   "end": 46.855,
   "text": "Rule number five. If they look at you, look at the floor."
  },
  {
   "line": 13,
   "sub": 0,
   "who": "N",
   "start": 47.305,
   "end": 49.535,
   "text": "Footsteps. Slow. Heavy. Coming down the aisle."
  },
  {
   "line": 14,
   "sub": 0,
   "who": "N",
   "start": 49.985,
   "end": 51.541,
   "text": "They stop. Right in front of you."
  },
  {
   "line": 15,
   "sub": 0,
   "who": "SIS",
   "start": 52.591,
   "end": 54.161,
   "text": "Why didn't you get off?"
  },
  {
   "line": 16,
   "sub": 0,
   "who": "N",
   "start": 55.511,
   "end": 56.004,
   "text": "Five"
  },
  {
   "line": 16,
   "sub": 1,
   "who": "N",
   "start": 56.754,
   "end": 57.322,
   "text": "Six"
  },
  {
   "line": 17,
   "sub": 0,
   "who": "N",
   "start": 57.972,
   "end": 60.365,
   "text": "Then your clock starts moving again. Backwards."
  },
  {
   "line": 18,
   "sub": 0,
   "who": "N",
   "start": 60.815,
   "end": 62.856,
   "text": "Station seven. The train doesn't stop."
  },
  {
   "line": 19,
   "sub": 0,
   "who": "N",
   "start": 63.306,
   "end": 66.237,
   "text": "And on the map above the door... an eighth station just appeared."
  },
  {
   "line": 20,
   "sub": 0,
   "who": "SPK",
   "start": 68.437,
   "end": 69.8,
   "text": "Next stop... your stop."
  },
  {
   "line": 21,
   "sub": 0,
   "who": "N",
   "start": 70.75,
   "end": 74.719,
   "text": "Rule two says never answer the announcements. But that voice... knows where you live."
  },
  {
   "line": 22,
   "sub": 0,
   "who": "N",
   "start": 75.469,
   "end": 77.173,
   "text": "Do you answer? Tell me in the comments."
  }
 ],
